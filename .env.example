# ── Discord ───────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key

# 사용할 OpenAI 모델 (기본값: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ── Server Settings ───────────────────────────────────────
# Discord 서버(길드) ID — 슬래시 커맨드 즉시 등록에 사용
GUILD_ID=your_guild_id

# 봇 시작 시 번역을 켜 놓을 채널 ID (쉼표로 구분, 없으면 비워두기)
TRANSLATE_CHANNEL_IDS=channel_id_1,channel_id_2

# 언어 역할 ID — /tr summary 출력 언어 결정에 사용
ROLE_KO=korean_role_id
ROLE_JA=japanese_role_id
