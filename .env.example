# .env 로 복사한 뒤 값을 채운다

# Discord 봇 토큰 (Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# OpenAI API 키 (AI 번역, 후리가나, /tr summary 에 사용)
OPENAI_API_KEY=
# 사용할 모델. 비우면 gpt-4o-mini
# trbot/ai.py 의 PRICES 에 없는 모델이면 /tr credits 비용이 unknown 으로 나온다
OPENAI_MODEL=gpt-6-luna
# fast 로 두면 OpenAI Fast 모드: 응답이 빨라지고 단가는 2배. 비우면 일반
OPENAI_SERVICE_TIER=

# 봇을 쓰는 서버 ID (개발자 모드 켜고 서버 우클릭 → ID 복사)
GUILD_ID=

# 한국어 / 일본어 사용자 역할 ID
# - /tr summary 요약 언어 선택
# - 상대 언어로 쓴 메시지는 번역 안 함 (ROLE_KO 가 일본어로 쓰면 번역 X, 반대도 같음)
ROLE_KO=
ROLE_JA=

# /genshin 명령어로 받고 뺄 수 있는 원신 채널 역할 ID
# 봇 역할에 '역할 관리' 권한이 있고, 역할 목록에서 봇 역할이 이 역할보다 위에 있어야 한다
ROLE_GENSHIN=

# 번역(AI)이 기본으로 켜질 채널 ID, 쉼표로 구분 (비워도 됨)
# 처음 실행할 때만 쓰인다. 이후에는 /tr on·off 결과가 state.json 에 저장되어 재시작해도 유지되고,
# 이 값을 바꿔도 반영되지 않는다 (반영하려면 state.json 삭제)
TRANSLATE_CHANNEL_IDS=
