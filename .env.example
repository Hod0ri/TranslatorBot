# ── Discord ───────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key

# 사용할 OpenAI 모델 (기본값: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ── Server Settings ───────────────────────────────────────
# Discord 서버(길드) ID — 슬래시 커맨드 즉시 등록에 사용
GUILD_ID=your_guild_id

# 봇 시작 시 번역을 켜 놓을 채널 ID (쉼표로 구분, 없으면 비워두기)
TRANSLATE_CHANNEL_IDS=channel_id_1,channel_id_2

# 언어 역할 ID — /tr summary 출력 언어 결정에 사용
ROLE_KO=korean_role_id
ROLE_JA=japanese_role_id

# ── Voice STT ─────────────────────────────────────────────
# 음성 번역 결과를 전송할 텍스트 채널 ID (0 또는 비우면 비활성화)
VOICE_TEXT_CHANNEL_ID=your_text_channel_id

# 발화 종료 판정 묵음 시간 (초, 기본값 1.5)
VOICE_SILENCE_TIMEOUT=1.5

# RMS 노이즈 임계값 (기본값 300 / 16-bit PCM 기준 max 32767)
# 조용한 환경: 200~300 / 잡음 많은 환경: 400~600
VOICE_NOISE_THRESHOLD=300
